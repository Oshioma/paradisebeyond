# Paradise Beyond — environment
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, secret) ---
# Bypasses RLS. Server code only. Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# 'mock' (default) or 'stripe'. The magazine demo runs on 'mock'.
PAYMENTS_PROVIDER=mock
# Stripe Connect (required only when PAYMENTS_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (ImprovMX SMTP) — for the app's own transactional emails ---
# Each site logs in with an ImprovMX SMTP credential on its own domain.
# Supabase AUTH emails (confirm/reset) are configured separately, in
# Supabase → Authentication → SMTP Settings (point Custom SMTP at ImprovMX).
SMTP_HOST=smtp.improvmx.com
SMTP_PORT=587
# Paradise Beyond (sends as EMAIL_FROM)
SMTP_USER=hello@paradisebeyond.com
SMTP_PASSWORD=
EMAIL_FROM="Paradise Beyond <hello@paradisebeyond.com>"
# Spend Time Off Grid (sends as noreply@spendtimeoffgrid.com — brand config)
OFFGRID_SMTP_USER=noreply@spendtimeoffgrid.com
OFFGRID_SMTP_PASSWORD=
# Where "new host application" alerts are sent. A plain inbox address (not the
# EMAIL_FROM sender). Leave blank to skip those notifications.
ADMIN_EMAIL=

# --- AI (Anthropic) — powers the "Draft with AI" retreat builder ---
# Server-only secret. Without it, the retreat builder falls back to local
# heuristic copy, so the app stays fully functional.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
ANTHROPIC_MODEL=

# --- Site ---
# Set to your deployed URL so auth email links don't point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot protection on sign-up / sign-in / password reset (Cloudflare Turnstile) ---
# Site key only; the secret key goes in Supabase → Authentication → Attack
# Protection. Set this and deploy BEFORE switching CAPTCHA on in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
