# Paradise Beyond — environment
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, secret) ---
# Bypasses RLS. Server code only. Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# 'mock' (default) or 'stripe'. The magazine demo runs on 'mock'.
PAYMENTS_PROVIDER=mock
# Stripe Connect (required only when PAYMENTS_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
